{
  "name": "react-centrifugo-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --filter react-centrifugo build",
    "build:docs": "vitepress build docs",
    "dev:docs": "vitepress dev docs",
    "preview:docs": "vitepress preview docs",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:package": "node scripts/verify-packages.mjs",
    "generate:hooks": "pnpm -r --filter './examples/*' generate:hooks",
    "validate:generated": "pnpm -r --filter './examples/*' validate:generated",
    "check": "pnpm build && pnpm generate:hooks && pnpm lint:typescript && pnpm lint:eslint && pnpm lint:prettier && pnpm test:unit && pnpm validate:generated && pnpm -r --filter './examples/*' build && pnpm test:package",
    "test:browser": "pnpm --filter react-centrifugo build && tsc --noEmit -p tests/browser && playwright test -c tests/browser/playwright.config.ts",
    "test:compatibility": "pnpm --filter react-centrifugo build && node scripts/verify-runtime-package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:release": "pnpm check && pnpm build:docs && pnpm test:browser && pnpm test:compatibility && pnpm verify:release"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@priemskiyyy/simulcast-codegen": "0.4.0",
    "@priemskiyyy/simulcast-devtools": "0.4.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "centrifuge": "5.7.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "ws": "8.21.3"
  }
}
