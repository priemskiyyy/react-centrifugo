{
  "name": "react-centrifugo-devtools",
  "version": "0.2.0",
  "description": "Browser devtools for react-centrifugo: inspect Centrifugo connections, channel subscriptions, and realtime events.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project devtools"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-centrifugo": ">=0.2.0 <0.3"
  },
  "devDependencies": {
    "react-centrifugo": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/react-centrifugo.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://priemskiyyy.github.io/react-centrifugo/devtools",
  "bugs": {
    "url": "https://github.com/priemskiyyy/react-centrifugo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "react-hooks",
    "centrifugo",
    "centrifuge",
    "devtools",
    "inspector",
    "debugging",
    "websocket",
    "realtime",
    "typescript"
  ],
  "dependencies": {
    "zod": "^4.6.2"
  }
}
