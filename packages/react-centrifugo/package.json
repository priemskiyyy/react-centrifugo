{
  "name": "react-centrifugo",
  "version": "0.3.0",
  "description": "React hooks for Centrifugo realtime messaging: shared WebSocket subscriptions, typed publications and events, connection state, and SSR-safe cleanup.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/react-centrifugo.git",
    "directory": "packages/react-centrifugo"
  },
  "homepage": "https://priemskiyyy.github.io/react-centrifugo/",
  "bugs": {
    "url": "https://github.com/priemskiyyy/react-centrifugo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project react-centrifugo"
  },
  "peerDependencies": {
    "centrifuge": ">=5.7.2 <6",
    "react": ">=19.2.0 <20"
  },
  "keywords": [
    "react",
    "react-hooks",
    "react-native",
    "centrifugo",
    "centrifuge",
    "centrifugal",
    "websocket",
    "realtime",
    "real-time",
    "pubsub",
    "subscriptions",
    "typed-events",
    "typescript",
    "ssr"
  ],
  "dependencies": {
    "@priemskiyyy/simulcast": ">=0.4.0 <0.5",
    "@priemskiyyy/simulcast-centrifugo": ">=0.4.0 <0.5",
    "@priemskiyyy/simulcast-react": ">=0.4.0 <0.5"
  }
}
